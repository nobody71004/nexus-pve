{
  "name": "nexus-pve",
  "productName": "NexusPVE",
  "version": "1.0.11",
  "description": "Nexus PVE — multi-host Proxmox fleet console with backup studio and an approval-gated agent/MCP pipeline.",
  "private": true,
  "main": "dist-electron/main.cjs",
  "author": "Nexus Ops",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "concurrently -k -n vite,main,app -c cyan,magenta,green \"vite\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:main": "node scripts/build-electron.mjs --watch",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-electron.mjs",
    "build:praetor": "node scripts/build-praetor-resources.mjs",
    "icon": "node scripts/build-icon.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "npm run build && electron .",
    "package": "npm run icon && npm run build && electron-builder --win",
    "package:dir": "npm run build && electron-builder --win --dir",
    "mcp": "node dist-electron/mcp-server.cjs",
    "mock:pve": "node scripts/mock-pve.mjs",
    "sync:server": "node scripts/team-sync-server.mjs",
    "smoke": "node scripts/agent-smoke.mjs",
    "smoke:praetor": "node scripts/praetor-install-smoke.mjs",
    "smoke:praetor:stdio": "node scripts/praetor-stdio-smoke.mjs",
    "smoke:agent-fabric": "node scripts/agent-fabric-smoke.mjs",
    "smoke:packaged": "node scripts/packaged-smoke.mjs",
    "smoke:sshkeys": "node scripts/sshkey-smoke.mjs",
    "verify:packaged": "npm run package:dir && npm run smoke:packaged",
    "test": "node tests/run-edge-tests.mjs",
    "preflight": "npm run typecheck && npm run build && npm test && npm run smoke && npm run smoke:gpu && npm run smoke:ui-scale && npm run smoke:hardware && npm run smoke:sshkeys && npm run smoke:agent-fabric",
    "ui:mock": "vite --port 5173",
    "preflight:local": "node scripts/local-preflight.mjs",
    "preflight:local:packaged": "node scripts/local-preflight.mjs --packaged",
    "smoke:gpu": "node scripts/gpu-smoke.mjs",
    "smoke:ui-scale": "node scripts/ui-scale-smoke.mjs",
    "smoke:hardware": "node scripts/hardware-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.11",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.6",
    "wait-on": "^8.0.2"
  },
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.15.2",
    "ssh2": "^1.17.0",
    "ws": "^8.22.2"
  },
  "build": {
    "appId": "dev.nexus.pve",
    "productName": "NexusPVE",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*",
      "scripts/**/*",
      "shared/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "dist-electron/mcp-server.cjs",
      "resources/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NexusPVE-${version}-portable.${ext}"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
